{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rekixo-3d-public",
  "compatibility_date": "2026-09-16",
  "main": "./workers/public.mjs",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ar3dstudio.in/3Dprojects",
      "zone_name": "ar3dstudio.in"
    },
    {
      "pattern": "ar3dstudio.in/3Dprojects/*",
      "zone_name": "ar3dstudio.in"
    }
  ],
  "assets": {
    "directory": "./apps/public/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/admin",
      "/admin/",
      "/3Dprojects",
      "/3Dprojects/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rekixo-3d-production",
      "database_id": "43423a10-66b2-4460-af5f-f6ab9f2947dc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MODEL_ASSETS",
      "bucket_name": "rekixo-3d-assets"
    }
  ]
}
